using EccsGuiBuilder.Client.Wrappers;
using EccsGuiBuilder.Client.Wrappers.AutoAssign;
using EccsGuiBuilder.Client.Layouts.Helper;
using LogicUI.MenuTypes;
using LogicAPI.Data;
using LogicWorld.Interfaces;
using RemoteControl.Shared.CustomData;
using System.Collections.Generic;
using EccsGuiBuilder.Client.Wrappers.RootWrappers;
using LogicLocalization;
using EccsGuiBuilder.Client.Wrappers.Specialized;
using LogicUI.MenuParts;
using LogicWorld.Players;
using LogicWorld.GameStates;

namespace RemoteControl.Client.Menus
{
	public class RemoteControlMenu : ToggleableSingletonMenu<RemoteControlMenu>,
		IAssignMyFields
	{
		public static WindowWrapper window = null;
		public static SimpleWrapper content = null;
		public static SimpleWrapper listBox = null;

		public static void UpdateScrollableArea()
		{
			if (window != null)
			{
				DestroyImmediate(window.gameObject);
			}
			window = WS.window("Remote Control Menu")
				.setLocalizedTitle("RemoteControl - Remote Control");
			window
				.configureContent(content => content
					.layoutVertical()
				)
				.add<RemoteControlMenu>()
				.build();
			content = window.contentWrapper;

			ComponentType remoteOutputType = Instances.MainWorld.ComponentTypes.GetComponentType("RemoteControl.RemoteOutput");

			foreach (var comp in Instances.MainWorld.Data.AllComponents)
			{
				if (comp.Value.Data.Type == remoteOutputType)
				{
					AddComponentToScrollArea(comp);
				}
			}
		}

		public static void AddComponentToScrollArea(KeyValuePair<ComponentAddress, ComponentDataManager> comp)
		{
			RemoteOutputClient comp_client_code = (RemoteOutputClient)Instances.MainWorld.Renderer.Entities.GetClientCode(comp.Key);

			// LocalizationMeshWrapper text_status = WS.textLine;
			// string status = "●";
			// if (!comp_client_code.GetOutputState())
			// 	status = "○";
			// text_status.gameObject.GetComponent<LocalizedTextMesh>()
			// 	.SetLocalizationKey(status, true);

			LocalizationMeshWrapper text_id = WS.textLine;
			text_id.gameObject.GetComponent<LocalizedTextMesh>()
				.SetLocalizationKey(comp_client_code.Data.Id, true);
			text_id.fixedSize(200, 80);

			SliderWrapper on_off_toggle = WS.slider;
			on_off_toggle
				.fixedSize(100, 80)
				.setMin(0)
				.setMax(1);

			// InputSlider on_off_toggle_obj = on_off_toggle.gameObject.GetComponent<InputSlider>();
			// on_off_toggle_obj.OnValueChanged += (value) => {
			// 	toggleOutput(comp_client_code);
			// };
			// DestroyImmediate(on_off_toggle_obj.GetComponent<TMP_InputField>());

			LocalizationMeshWrapper on_off = WS.button;
			on_off.setLocalizationKey("⏻");
			HoverButton on_off_button = on_off.gameObject.GetComponent<HoverButton>();
			on_off_button.OnClickEnd += () => {
				toggleOutput(comp_client_code);
			};

			LocalizationMeshWrapper pulse = WS.button;
			pulse.setLocalizationKey("⚡");
			HoverButton pulse_button = pulse.gameObject.GetComponent<HoverButton>();
			pulse_button.OnClickEnd += () => {
				pulseOutput(comp_client_code);
			};


			LocalizationMeshWrapper teleport = WS.button;
			teleport.setLocalizationKey("📍");
			HoverButton teleport_button = teleport.gameObject.GetComponent<HoverButton>();
			teleport_button.OnClickEnd += () => {
				teleportToRemoteComponent(comp.Value);
			};

			content.addContainer("Box " + comp_client_code.Data.Id, box => box
				.layoutHorizontal()
				.add(text_id)
				.add(on_off)
				.add(pulse)
				.add(teleport)
			);
		}

		public static void toggleOutput(
			RemoteOutputClient client_code
		)
		{
			client_code.Data.Action = RemoteOutputAction.Toggle;
		}

		public static void pulseOutput(
			RemoteOutputClient client_code
		)
		{
			client_code.Data.Action = RemoteOutputAction.Pulse;
		}

		public static void teleportToRemoteComponent(
			ComponentDataManager comp
		)
		{
			PlayerControllerManager.TeleportSelf(comp.WorldPosition);
			GameStateManager.TransitionBackToBuildingState();
		}
	}
}